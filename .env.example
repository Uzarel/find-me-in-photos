# Copy to ".env" and adjust. The ".env" file is ignored by git.

# --- Local mode (docker compose up -d) ---
# PHOTOS_DIR=./photos
# PORT=8000

# --- Event mode (see README.md) ---
# Code guests enter, 8 characters or more. Pick something hard to guess.
ACCESS_CODE=change-me-please
EVENT_NAME=your-event-name

# With "--profile proxy": the name or address guests will open.
#   Public domain:  EVENT_HOST=myevent.duckdns.org  (leave EVENT_TLS empty;
#                   needs ports 80 and 443 forwarded, see README.md)
#   Local network:  EVENT_HOST=192.168.1.50  and  EVENT_TLS=tls internal
EVENT_HOST=localhost
EVENT_TLS=tls internal
